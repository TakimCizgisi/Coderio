{
    "name": "coderio",
    "displayName": "Coderio",
    "description": "Autonomous local AI coding assistant (Coderio) — Phantom",
    "version": "0.6.0",
    "license": "LicenseRef-TakimCizgisi-LSH-1.0",
    "type": "module",
    "author": "TakımÇizgisi LSH Yazılım Geliştirme Grubu Ve Topluluğu",
    "keywords": [
        "ai",
        "llm",
        "local",
        "agent",
        "coding-agent",
        "electron",
        "llama-cpp",
        "gemma",
        "qwen",
        "cuda",
        "vulkan",
        "offline"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/takimcizgisi/coderio.git"
    },
    "homepage": "https://github.com/takimcizgisi/coderio",
    "bugs": {
        "url": "https://github.com/takimcizgisi/coderio/issues"
    },
    "main": "dist/main.js",
    "engines": {
        "node": ">=26.4.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "start": "npm run build && electron .",
        "dev": "node esbuild.mjs --watch",
        "pack": "npm run build && electron-builder --win --dir",
        "dist": "npm run build && electron-builder --win nsis --x64 --linux tar.gz",
        "clean": "node scripts/clean.mjs",
        "icon": "electron scripts/make-icon.cjs",
        "test:tools": "tsx scripts/smoke-tools.ts",
        "test:new": "tsx scripts/smoke-new-tools.ts",
        "test:ipc": "tsx scripts/smoke-ipc.ts",
        "test:title": "tsx scripts/smoke-title.ts",
        "cli": "node dist/cli/index.js",
        "check:gpu": "tsx scripts/check-gpu.ts"
    },
    "dependencies": {
        "adm-zip": "^0.6.1",
        "js-yaml": "^5.3.0",
        "node-llama-cpp": "3.21.1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.13.3",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.12",
        "typescript": "^5.7.3"
    },
    "allowScripts": {
        "node-llama-cpp@3.21.1": true,
        "esbuild@0.28.2": true,
        "electron@44.5.1": true,
        "electron-builder@26.15.3": true
    }
}
